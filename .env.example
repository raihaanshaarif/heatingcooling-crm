# Database: any PostgreSQL 16 (local install, or the Postgres you create in Coolify)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coolops?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# Public base URL used in emailed links (quotes / invoices)
APP_URL="http://localhost:3000"

# Email (Resend). Leave RESEND_API_KEY empty to log emails to the console instead.
RESEND_API_KEY=""
EMAIL_FROM="Cooling Service Melbourne <office@coolingservicemelbourne.com.au>"

# Website contact form -> POST /api/leads/webhook with header x-api-key
LEAD_WEBHOOK_SECRET="change-me-long-random-string"
# Only needed when the browser posts directly: comma-separated origins, e.g. https://coolingservicemelbourne.com.au
LEAD_WEBHOOK_ALLOWED_ORIGINS=""

# Coolify scheduled task (pnpm cron:reminders) -> /api/cron/reminders with Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-long-random-string"

# File storage. STORAGE_DRIVER=local writes to STORAGE_LOCAL_DIR (on Coolify, mount a persistent volume there).
# Or use s3 for Cloudflare R2 / Supabase / AWS.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./uploads"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_PUBLIC_URL=""


# SMS texts to clients (on my way, appointment / service-due / overdue reminders, one-off texts).
# SMS_PROVIDER=twilio or messagemedia. Empty (or credentials missing) = texts are written to the
# SMS log and printed to the server console, never sent. Toggles and wording: Settings -> SMS.
SMS_PROVIDER=""
# MessageMedia (Australian): Hub -> Settings -> API settings -> create a Basic auth API key.
MESSAGEMEDIA_API_KEY=""
MESSAGEMEDIA_API_SECRET=""
# Twilio: Console -> Account info (Account SID + Auth token).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Optional for Twilio instead of SMS_FROM: a Messaging Service SID (MG...).
TWILIO_MESSAGING_SERVICE_SID=""
# Sender: your Twilio/MessageMedia number (+614...) or an alphanumeric sender ID (max 11 chars,
# e.g. CoolService; clients can't reply to it). Required for Twilio (unless a Messaging Service
# SID is set; an MG... value here also works). Optional for MessageMedia (empty = shared number).
SMS_FROM=""

# Xero live sync (CoolOps -> Xero: contacts, invoices, voids, credit notes, payments).
# Create a Web app at developer.xero.com -> My Apps -> New app, with redirect URI
# {APP_URL}/api/integrations/xero/callback, then copy its Client id and a generated Client secret.
# Empty = Xero shows "Not set up" on the Integrations page (the CSV export still works).
# Tokens are stored encrypted with a key derived from AUTH_SECRET: changing AUTH_SECRET means
# reconnecting Xero.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Optional: space-separated scopes if your Xero app needs different ones (default:
# offline_access accounting.transactions accounting.contacts accounting.settings.read).
XERO_SCOPES=""
# Testing only: point at a mock server instead of api.xero.com / identity.xero.com.
XERO_API_URL=""
XERO_IDENTITY_URL=""

# Google Calendar sync (CoolOps -> each user's own Google Calendar, one way).
# console.cloud.google.com -> new project -> enable "Google Calendar API" -> OAuth consent screen
# (External; scopes openid, email, .../auth/calendar.events) -> Credentials -> Create OAuth
# client ID (Web application) with redirect URI {APP_URL}/api/integrations/google/callback.
# Empty = "Not set up": the Connect button is hidden on My account, nothing is sent.
# Tokens are stored encrypted with a key derived from AUTH_SECRET: changing AUTH_SECRET means
# everyone reconnects.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Testing only: point at a mock server instead of accounts.google.com / oauth2.googleapis.com /
# www.googleapis.com/calendar/v3.
GOOGLE_AUTHORIZE_URL=""
GOOGLE_OAUTH_URL=""
GOOGLE_CALENDAR_API_URL=""

# Route optimisation (Schedule -> Plan route). One server API key from console.cloud.google.com
# with the Geocoding API, Routes API and Maps Static API enabled (restrict the key to those APIs).
# Empty = no Google calls: addresses are placed at their suburb centre and drive times are
# estimated from straight-line distance x 1.3 at 40 km/h. The "Open in Google Maps" links for
# technicians work either way (they need no key).
GOOGLE_MAPS_API_KEY=""
# Testing only: point at a mock server instead of maps.googleapis.com / routes.googleapis.com.
GOOGLE_GEOCODING_URL=""
GOOGLE_ROUTES_URL=""
GOOGLE_STATIC_MAPS_URL=""
